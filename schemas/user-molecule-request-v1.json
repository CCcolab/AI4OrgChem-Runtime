{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "service": {
      "const": "user-molecule-fixed"
    },
    "geometry_file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "coordinate_unit": {
      "const": "angstrom"
    },
    "charge": {
      "const": 0,
      "type": "integer"
    },
    "multiplicity": {
      "const": 1,
      "type": "integer"
    },
    "research_question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "condition_definition_acknowledged": {
      "const": true,
      "type": "boolean"
    },
    "fragments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "A",
              "B"
            ]
          },
          "carbon_atom_indices_1based": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            }
          }
        },
        "required": [
          "id",
          "carbon_atom_indices_1based"
        ]
      }
    },
    "condition_profile": {
      "const": "cross-fragment-pi-2011-v1"
    },
    "calculation_profile": {
      "enum": [
        "pilot-b3lypg-sto3g-grid2-v1",
        "research-b3lypg-631gd-grid3-v1"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "memory_limit_mib": {
          "type": "integer",
          "minimum": 128,
          "maximum": 4096
        },
        "wall_time_limit_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        }
      },
      "required": [
        "threads",
        "memory_limit_mib",
        "wall_time_limit_seconds"
      ]
    }
  },
  "required": [
    "schema_version",
    "service",
    "geometry_file",
    "coordinate_unit",
    "charge",
    "multiplicity",
    "research_question",
    "condition_definition_acknowledged",
    "fragments",
    "condition_profile",
    "calculation_profile",
    "resources"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4orgchem:user-molecule-request:v1"
}
